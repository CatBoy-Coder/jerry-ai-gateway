# ==========================================
# jerry-ai-gateway 环境变量配置模板
# 使用说明：请复制本文件并重命名为 .env，然后填入你的真实密钥
# ==========================================

# 【必填】上游大模型 API Key（默认适配阿里云百炼 DashScope）
DASHSCOPE_API_KEY=sk-your-real-dashscope-api-key-here

# 【可选】网关监听端口，默认 3000
GATEWAY_PORT=3000

# 【可选】上游推理接口地址，默认指向阿里云百炼 OpenAI 兼容端点
UPSTREAM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 【可选】客户端访问本网关的鉴权 Key（生产环境请务必修改为高强度随机字符串）
GATEWAY_API_KEY=sk-jerry-gateway-local-dev-key

# 【可选】全局限流阈值（每秒允许的最大请求数 QPS），默认 2
RATE_LIMIT_PER_SEC=2