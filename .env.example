# ==========================================
# jerry-ai-gateway 基础配置
# ==========================================
GATEWAY_PORT=3000
GATEWAY_API_KEY=sk-jerry-gateway-local-dev-key
RATE_LIMIT_PER_SEC=2

# 【可选】Docker/K8s 等无 .env 文件部署时，可显式指定降级顺位
# FALLBACK_ORDER=DASHSCOPE,DEEPSEEK,GEMINI

# ==========================================
# 上游模型通道配置（约定：严格按从上至下的声明顺序作为默认与降级链路）
# 规则：配置 <名称>_API_KEY 即自动注册通道，零代码扩展任意 OpenAI 兼容厂商
# ==========================================

# [顺位 1 - 默认主力] 阿里云百炼
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_DEFAULT_MODEL=qwen-plus
DASHSCOPE_MODEL_PREFIX=qwen-

# [顺位 2 - 第一备胎] DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_MODEL_PREFIX=deepseek-

# [顺位 3 - 终极兜底] Google Gemini（跨协议转换）
GEMINI_API_KEY=AIza-your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_MODEL_PREFIX=gemini-
GEMINI_PROTOCOL=gemini

# ------------------------------------------
# 开源扩展示例：无需修改任何 Rust 代码，取消注释即可接入 Kimi (Moonshot)
# MOONSHOT_API_KEY=sk-your-moonshot-api-key
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1/chat/completions
# MOONSHOT_DEFAULT_MODEL=moonshot-v1-8k
# MOONSHOT_MODEL_PREFIX=moonshot-
# ------------------------------------------